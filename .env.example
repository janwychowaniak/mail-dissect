# Every variable is optional: the image starts with sensible defaults (SPEC §19).
# Values below are the defaults, shown so that the full surface is visible in one place.

# --- Optional tools (SPEC §14). Empty means `disabled`, not "broken". ---
# They must be reachable for the SERVICE, not for the consumer, and need access to nothing
# but it. Without them the dissection is poorer, never wrong.
TIKA_URL=
SCREENSHOT_URL=

# --- Limits (SPEC §15) ---
MAX_MESSAGE_BYTES=52428800
MAX_ATTACHMENT_BYTES=26214400
MAX_NESTING_DEPTH=5
MAX_MIME_PARTS=500
MAX_INLINE_BODY_BYTES=262144

# --- Time budgets: three, not one ---
DISSECT_TIMEOUT_SECONDS=60
TIKA_TIMEOUT_SECONDS=20
SCREENSHOT_TIMEOUT_SECONDS=30
HEALTH_PROBE_TIMEOUT_SECONDS=2
HEALTH_CACHE_TTL_SECONDS=10

# --- Artifacts (SPEC §13.4). ARTIFACT_DIR is best mounted as tmpfs. ---
ARTIFACT_TTL_SECONDS=1800
ARTIFACT_DIR=/tmp

# --- Extension registry supplement (SPEC §12, [D22]) ---
# The registry is keyed by media type, so formats without a registered one are absent from
# it: scr, pif, hta, ps1, vbs, wsf and friends. This adds extensions for THIS deployment;
# it never removes any. Empty by default - a list shipped by us would be our point of view,
# and the service does not have one. Both forms work: `scr,hta` or ["scr","hta"].
# The value is reported in /v1/health and folded into the registry version, because it
# changes what the same string is recognised as.
# Example:
# EXTRA_FILE_EXTENSIONS=scr,pif,hta,ps1,psm1,vbs,vbe,jse,wsf,wsh,cmd,reg
EXTRA_FILE_EXTENSIONS=

# --- Link unwrappers (SPEC §10), a JSON array. Empty by default: shipping a ready-made
# list would be a choice about whose filters matter. Malformed JSON stops the service.
# Example (one entry, on one line):
# UNWRAPPERS=[{"host_suffix":"safelinks.protection.outlook.com","source":"query:url","decoder":"percent"}]
UNWRAPPERS=
